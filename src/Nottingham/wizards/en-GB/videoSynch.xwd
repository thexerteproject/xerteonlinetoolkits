<wizard menus="Media">  <pageWizard remove="true" duplicate="false">    <newNodes>          <videoSynch><![CDATA[<videoSynch name="Enter Page Title" url="" text="" pause="True" erase="True"      panelWidth="Medium" panelWidthCustom="50" align="Right" panelStyle="false"      />]]></videoSynch>    </newNodes>  	    </pageWizard>  <!-- SYNCHED VIDEO=============================================== -->  <videoSynch menu="Media" menuItem="Synched Video" hint="Synchronise passages of text to a movie." icon="icPageWhiteOffice"  thumb="thumbs/videoSynch.jpg" example="https://xot.xerte.org.uk/play_116?hide=bottom#synchedvideo" wiki="https://xerte.org.uk/wiki/doku.php?id=media_synched_video_page" remove="true">    <name label="Page Title" type="TextInput" wysiwyg="true" />    <text label="Page Text" type="TextArea"  height="200" placeholder="Enter text for the page here"/>    <url label="Video" type="Media" placeholder="Select a video file or enter a URL/embed code" enableImgSHTool="false" />    <pause label="Pause on Sync Points" type="Checkbox" defaultValue="True" />    <erase label="Erase on Sync Points" type="Checkbox" defaultValue="True" />    <layoutGroup label="Page Layout" type="group">        <panelWidth label="Panel Width" options=",Small,Medium,Large,Custom" type="ComboBox" data=",Small,Medium,Large,Custom" defaultValue="" mandatory="true" conditionTrigger="true"/>        <panelWidthCustom label="Custom Width (%)" type="NumericStepper" min="10" max="90" step="1" defaultValue="50" condition="panelWidth=='Custom'"/>        <align label="Panel Position" options="Right,Left" type="ComboBox" data="Right,Left" defaultValue="Right"/>        <panelStyle label="Remove Panel Style" type="CheckBox" defaultValue="true" />    </layoutGroup>    <textTopGroup label="Text Above Panel" type="group" optional="true">        <textTop label="Text" type="TextArea" height="100" optional="true"/>        <textTopWidth label="Full Width" type="CheckBox" optional="true" defaultValue="false" condition="panelWidth!='Full'"/>    </textTopGroup>    <textBelowGroup label="Text Below Panel" type="group" optional="true">        <textBottom label="Text" type="TextArea" height="100" optional="true"/>        <textBottomWidth label="Full Width" type="CheckBox" optional="true" defaultValue="false" condition="panelWidth!='Full'"/>    </textBelowGroup>    <aspectRatio label="Aspect Ratio" type="TextInput" defaultValue="" placeholder="16:9" tooltip="Aspect ratio of video, e.g. 16:9" optional="true" />    <movieSize label="Video Size" type="textInput" defaultValue="" placeholder="e.g. 320,240" optional="true" tooltip="By default videos will be scaled automatically to best fit on the page. This option fixes the video size (width,height). Use with caution!" deprecated="This property is deprecated. Use the panel width option to change the page layout instead."/>	<timedText label="Timed Text File" type="Media" optional="true" placeholder="Select a timed text file"/>	<trackingWeight label="Tracking Score Weight" optional="true" type="textInput" width="120" defaultValue="1.0" tooltip="Customise the weight of the task on this page, relative to other scored pages in the project. Setting the weight to 0 will mean that the task on this page will not contribute to the project's overall score." />    <newNodes>      <videoSynchPoint><![CDATA[<videoSynchPoint name="Sync Point" text="" synch="0"/>]]></videoSynchPoint>    </newNodes>  </videoSynch>    <videoSynchPoint menuItem="Sync Point" icon="icBullet" remove="true">    <name label="Label" type="TextInput" wysiwyg="true" tooltip="The label only appears in the editor's project structure panel and is not shown in the project itself. Unique and meaningful labels can be used to make sync points easier to locate for editing at a later date." />    <text label="Text" type="TextArea" height="250" placeholder="Content to add at sync point" />    <synch label="Sync Point" type="synchPoint" src="parent.url"/>	<imgInfo type="group" label="Image" optional="true">		<url label="Image" type="media"  optional="true" defaultValue="Select an image"/>		<tip label="Description" type="textInput"  optional="true" defaultValue="" placeholder="Enter a description for accessibility"/>		<caption label="Caption" type="textInput" optional="true" defaultValue="" wysiwyg="true" placeholder="Enter the caption text" tooltip="Optional: add a caption below the image"/>        <align label="Position" options="Above text,Below text" type="ComboBox" data="Bottom,Top" optional="true" defaultValue="Top"/>	</imgInfo>      </videoSynchPoint>  </wizard>