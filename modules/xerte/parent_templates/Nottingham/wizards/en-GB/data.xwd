		<imgGenApi label="Service" type="comboBox_imagegen" defaultValue="gpt1" width="120" optional="true" conditionTrigger="true" tooltip="Dalle2: Attempt to generate the specified number of images based on the given descriptions using an AI model; Dalle3: Attempt to generate a single image based on the given description using an AI model." condition="serviceType=='generate' &amp;&amp; hasrole('aiuser')"/>
		<imgmodelver label="Model Version" tooltip="Choose one of the available models for image generation." options="GPT Image 1, GPT Image 1 Mini, GPT Image 1.5" type="comboBox" data="gpt-image-1, gpt-image-1-mini, gpt-image-1.5" defaultValue="gpt-image-1" condition="serviceType=='generate' &amp;&amp; imgGenApi=='gpt1'" optional="true"/>
