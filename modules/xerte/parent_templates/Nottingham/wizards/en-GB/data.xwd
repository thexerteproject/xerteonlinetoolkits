		<useAiInterpret label="Enable AI Query Interpretation" tooltip="This option results in your chosen AI model rewriting your request to better match the selected service." type="Checkbox" conditionTrigger="true" condition="hasrole('aiuser') &amp;&amp; vendor_is_available('ai','all')" defaultValue="false" optional="true"/>
